[resource]
code = "shader_type spatial;
render_mode specular_schlick_ggx, async_visible;

uniform vec4 Color1 : hint_color = vec4(0.329412, 0.384314, 0.435294, 1.000000);
uniform vec4 Color2 : hint_color = vec4(0.701961, 0.701961, 0.701961, 1.000000);
uniform sampler2D RGB_Mask;
uniform sampler2D Normal : hint_normal;
uniform float Normalmap_dpth = 2;



void vertex() {
// Output:0

}

void fragment() {
// ColorUniform:15
	vec3 n_out15p0 = Color1.rgb;
	float n_out15p1 = Color1.a;

// ColorUniform:16
	vec3 n_out16p0 = Color2.rgb;
	float n_out16p1 = Color2.a;

// TextureUniform:12
	vec3 n_out12p0;
	float n_out12p1;
	{
		vec4 n_tex_read = texture(RGB_Mask, UV.xy);
		n_out12p0 = n_tex_read.rgb;
		n_out12p1 = n_tex_read.a;
	}

// VectorDecompose:3
	float n_out3p0 = n_out12p0.x;
	float n_out3p1 = n_out12p0.y;
	float n_out3p2 = n_out12p0.z;

// VectorMix:7
	vec3 n_out7p0 = mix(n_out15p0, n_out16p0, vec3(n_out3p0));

// VectorOp:8
	vec3 n_out8p0 = n_out7p0 * vec3(n_out3p1);

// VectorOp:9
	vec3 n_out9p0 = n_out8p0 * vec3(n_out3p2);

// ScalarMix:19
	float n_in19p0 = 0.80000;
	float n_in19p1 = 0.75000;
	float n_out19p0 = mix(n_in19p0, n_in19p1, n_out3p0);

// TextureUniform:13
	vec3 n_out13p0;
	float n_out13p1;
	{
		vec4 n_tex_read = texture(Normal, UV.xy);
		n_out13p0 = n_tex_read.rgb;
		n_out13p1 = n_tex_read.a;
	}

// ScalarUniform:14
	float n_out14p0 = Normalmap_dpth;

// Output:0
	ALBEDO = n_out9p0;
	ROUGHNESS = n_out19p0;
	NORMALMAP = n_out13p0;
	NORMALMAP_DEPTH = n_out14p0;

}

void light() {
// Output:0

}
